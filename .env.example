MSSQL_SA_PASSWORD=ChangeThis_ToAStrongPassword1!
JWT_ACCESS_SECRET=replace-this-with-a-random-secret-at-least-32-characters
# Keep false for local HTTP; set true when serving the API over HTTPS.
COOKIE_SECURE=false
# Kafka's host listener for running the server outside Docker.
KAFKA_BROKERS=localhost:29092
KAFKA_CONSUMER_GROUP=chat-notifications-v1
# Optional for local server development; set only when a Redis instance is reachable from the host.
# REDIS_URL=redis://localhost:6379
# Client container runtime API root; leave empty to use a same-origin reverse proxy.
REACT_APP_API_ROOT=http://localhost:5000
# Public origin of the client, used by server CORS.
CLIENT_URL=http://localhost:3000
